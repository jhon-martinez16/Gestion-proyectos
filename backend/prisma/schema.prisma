generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoProyecto {
  EN_CURSO
  ADVERTENCIA
  EN_RIESGO
  FINALIZADO
}

enum EstadoCompromiso {
  PENDIENTE
  CUMPLIDO
  NO_CUMPLIDO
  REPROGRAMADO
}

enum EstadoEntregable {
  PENDIENTE
  ADVERTENCIA
  URGENTE
  VENCIDO
  COMPLETADO
}

enum Rol {
  ADMIN
  SOCIO
  ADMINISTRATIVO
}

enum EstadoFactura {
  PENDIENTE
  APROBADA
  PAGADA
  RECHAZADA
}

enum EtapaProyecto {
  PROPUESTA
  KICK_OFF
  EN_EJECUCION
  CIERRE
}

enum TipoFeedback {
  POSITIVO
  NEGATIVO
  MEJORA
}

enum PagoEstado {
  PENDIENTE
  RECIBIDO
  VENCIDO
  PARCIAL
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(SOCIO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  proyectosLider  Proyecto[] @relation("LiderProyecto")
  proyectosSocio2 Proyecto[] @relation("Socio2Proyecto")

  compromisos     Compromiso[]
  entregables     Entregable[]
  notificaciones  NotificacionInterna[] @relation("DestinoNotificacion")
}

model Categoria {
  id        String   @id @default(uuid())
  nombre    String   @unique
  color     String
  activa    Boolean  @default(true)
  orden     Int
  createdAt DateTime @default(now())

  proyectos Proyecto[]
}

model Proyecto {
  id                String         @id @default(uuid())
  nombre            String
  descripcion       String
  fechaInicio       DateTime
  fechaFin          DateTime
  estado            EstadoProyecto @default(EN_CURSO)
  etapa             EtapaProyecto  @default(PROPUESTA)
  contratoFirmado   Boolean        @default(false)
  kickoffRealizado  Boolean        @default(false)
  kickoffFecha      DateTime?
  propuestaAprobada Boolean        @default(false)
  requierePoliza    Boolean        @default(false)
  requiereContrato  Boolean        @default(true)
  polizaContratada  Boolean        @default(false)
  createdAt         DateTime       @default(now())

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  liderId String
  lider   Usuario @relation("LiderProyecto", fields: [liderId], references: [id])

  socio2Id String
  socio2   Usuario @relation("Socio2Proyecto", fields: [socio2Id], references: [id])

  compromisos          Compromiso[]
  entregables          Entregable[]
  historial            HistorialProyecto[]
  reuniones            ReunionSeguimiento[]
  facturas             Factura[]
  feedbacks            FeedbackInterno[]
  pagosCliente         PagoCliente[]
  nota                 NotaProyecto?
  notificaciones       NotificacionInterna[]
  cronogramaVersiones  CronogramaVersion[]
  feedbacksCliente     FeedbackCliente[]

  documentosFacturacionRecibidos Boolean @default(false)
  proveedorValidado               Boolean @default(false)
  documentosPolizaConfirmados     Boolean @default(false)
}

model Factura {
  id                    String        @id @default(uuid())
  numero                String
  concepto              String
  monto                 Decimal
  estado                EstadoFactura @default(PENDIENTE)
  fechaEmision          DateTime
  fechaPago             DateTime?
  observaciones         String?
  comprobantePagoPath   String?
  archivoFacturaPath    String?
  fechaProgramadaPago   DateTime?
  pagoEjecutado         Boolean       @default(false)
  fechaPagoEjecutado    DateTime?
  confirmacionFinanciera Boolean      @default(false)
  createdAt             DateTime      @default(now())

  proyectoId  String
  proyecto    Proyecto   @relation(fields: [proyectoId], references: [id])

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
}

model Proveedor {
  id                 String   @id @default(uuid())
  nombre             String
  nit                String   @unique
  email              String?
  telefono           String?
  activo             Boolean  @default(true)
  categoriaProveedor String?
  createdAt          DateTime @default(now())

  facturas Factura[]
}

model ReunionSeguimiento {
  id              String    @id @default(uuid())
  fecha           DateTime
  objetivos       String
  proximospasos   String?
  calidadAprobada Boolean   @default(false)
  proximaReunion  DateTime?
  createdAt       DateTime  @default(now())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])

  compromisos Compromiso[]
}

model Compromiso {
  id            String           @id @default(uuid())
  descripcion   String
  fechaOriginal DateTime
  fechaActual   DateTime
  estado        EstadoCompromiso @default(PENDIENTE)
  comentario    String?
  createdAt     DateTime         @default(now())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])

  responsableId String?
  responsable   Usuario? @relation(fields: [responsableId], references: [id])

  reunionId String?
  reunion   ReunionSeguimiento? @relation(fields: [reunionId], references: [id])
}

model Entregable {
  id                      String           @id @default(uuid())
  nombre                  String
  descripcion             String
  fechaEntrega            DateTime
  estado                  EstadoEntregable @default(PENDIENTE)
  revisionInternaAprobada Boolean          @default(false)
  clienteAprobado         Boolean          @default(false)
  observacionesCliente    String?
  fechaAprobacionCliente  DateTime?
  createdAt               DateTime         @default(now())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])

  responsableId String?
  responsable   Usuario? @relation(fields: [responsableId], references: [id])

  feedbacksCliente FeedbackCliente[]
}

model HistorialProyecto {
  id      String   @id @default(uuid())
  accion  String
  detalle String
  fecha   DateTime @default(now())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
}

model FeedbackInterno {
  id              String       @id @default(uuid())
  tipo            TipoFeedback
  descripcion     String
  accionesTomadas String?
  creadoPor       String
  createdAt       DateTime     @default(now())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
}

model PagoCliente {
  id                       String     @id @default(uuid())
  numeroCuota              Int
  descripcion              String
  montoEsperado            Decimal
  montoRecibido            Decimal?
  fechaEsperada            DateTime
  fechaRecibido            DateTime?
  estado                   PagoEstado @default(PENDIENTE)
  comprobantePath          String?
  archivoComprobantePath   String?
  observaciones            String?
  createdAt                DateTime   @default(now())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
}

model NotaProyecto {
  id          String   @id @default(uuid())
  contenido   String
  creadoPorId String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  proyectoId String   @unique
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
}

model NotificacionInterna {
  id        String   @id @default(uuid())
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  usuarioDestinoId String
  usuarioDestino   Usuario  @relation("DestinoNotificacion", fields: [usuarioDestinoId], references: [id])

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
}

model CronogramaVersion {
  id                 String    @id @default(uuid())
  version            Int
  descripcionCambios String
  aprobadoCliente    Boolean   @default(false)
  fechaAprobacion    DateTime?
  creadoPorId        String
  createdAt          DateTime  @default(now())

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
}

model FeedbackCliente {
  id              String   @id @default(uuid())
  calificacion    Int
  comentario      String
  fechaFeedback   DateTime
  registradoPorId String
  createdAt       DateTime @default(now())

  proyectoId    String
  proyecto      Proyecto   @relation(fields: [proyectoId], references: [id])

  entregableId  String?
  entregable    Entregable? @relation(fields: [entregableId], references: [id])
}


